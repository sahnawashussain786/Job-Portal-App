# Copy to `.env` and adjust if needed. The defaults below work out of the box
# for local development with `npm run dev`.

# ---------------------------------------------------------------------------
# API base URL used by the browser
# ---------------------------------------------------------------------------
# Leave EMPTY. Empty means the app requests the relative path `/api`, which is
# correct in both environments:
#
#   • Development — Vite's dev server proxies `/api` to Express (see below),
#     so there is no CORS and no port to keep in sync.
#   • Production on Vercel — the SPA and the API share a domain, so `/api`
#     resolves to the serverless functions.
#
# Only set this when the API genuinely lives on a different origin:
#   VITE_API_URL=https://your-api.example.com
VITE_API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Dev proxy target (development only, config-only — never shipped to the client)
# ---------------------------------------------------------------------------
# Where `vite dev` forwards `/api` requests. Change only if Express is not on
# the default port.
DEV_API_URL=http://localhost:5000
