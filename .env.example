# ---------------------------------------------------------------------------
# Backend (root + `backend/` when running locally)
# Copy to `.env` in the repo root, or to `backend/.env` for local API dev.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# MongoDB — use MongoDB Atlas for Vercel (local mongod will NOT work on Vercel).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobportal?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API (dev only; the
# deployed frontend is same-origin so it needs no entry here).
CLIENT_URL=http://localhost:5173

# Cloudinary — used for resume + company logo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap: the seed script promotes this email to `admin`.
ADMIN_EMAIL=admin@jobportal.dev

# ---------------------------------------------------------------------------
# Frontend (`frontend/.env` or `frontend/.env.local`)
#
# VITE_API_URL should stay EMPTY. The app requests the relative path `/api`,
# which works in both places: Vite proxies it to Express in development, and on
# Vercel the SPA and API share a domain. See frontend/.env.example.
# ---------------------------------------------------------------------------
VITE_API_URL=
